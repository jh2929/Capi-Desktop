_pkgname=capi-desktop
pkgname="${_pkgname}-bin"
pkgver=0.1.4
pkgrel=1
pkgdesc="Cliente gráfico para YouTube Music con soporte de descargas y Discord RPC"
arch=('x86_64')
url="https://github.com/jh2929/Capi-Desktop"
license=('GPL-3.0-only')
depends=(
  'gtk3'
  'webkit2gtk-4.1'
  'libayatana-appindicator'
  'libsoup3'
  'glib2'
  'gcc-libs'
  'zlib'
  'openssl'
)
makedepends=()
optdepends=()
provides=("${_pkgname}")
conflicts=("${_pkgname}")
source=("${url}/releases/download/v${pkgver}/capi_${pkgver}_amd64.deb")
sha256sums=('SKIP')
noextract=()

package() {
  bsdtar -xf data.tar.* -C "${pkgdir}"
}
